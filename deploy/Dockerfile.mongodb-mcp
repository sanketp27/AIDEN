FROM node:20-alpine
WORKDIR /app
RUN npm install --global @mongodb-js/mongodb-mcp-server && npm cache clean --force
ENV MCP_TRANSPORT=sse MCP_PORT=8002 MCP_MONGODB_READ_ONLY=true
EXPOSE 8002
HEALTHCHECK --interval=20s --timeout=5s --start-period=20s --retries=3 \
    CMD wget -qO- http://localhost:8002/health || exit 1
CMD ["mongodb-mcp-server", "--port", "8002"]
